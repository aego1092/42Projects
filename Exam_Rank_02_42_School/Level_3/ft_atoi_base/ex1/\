#include <stdio.h>


int	ft_isdigit(char c)
{
	if (c >= '0' && c <= '9')
		return(1);
	else
		return(0);
}

int	ft_isspace(char	c)
{
	if ((c >= 9 && c <=13) || c == 32)
	{
		return(1);
	}
	else
		return(0);
}

int	ft_atoi_base(const char	*str, int	str_base)
{
	int	res;
	int	i;
	int	sign;
	char	s[16] = "0123456789abcdef";
	
	res = 0;
	i = 0;
	sign = 1;

	while (str[i])
	{
		if (ft_isspace(str[i]))
			i++;
		if (str[i] == '-' || str[i] == '+')
		{
			if (str[i] == '-')
			{
				sign = -1 * sign;
			}
			i++;
		}
		if (ft_isdigit(str[i]))
		{
			res = res * 10 + (str[i] - '0');
		}
		i++;
	}
	return (sign * res);
}

